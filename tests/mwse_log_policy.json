{
  "default": "warn",
  "rules": [
    {
      "pattern": "stack traceback:|Error in event callback:",
      "severity": "fail"
    },
    {
      "pattern": "HTTP/1\\.1 5[0-9]{2}\\b|\\\"code\\\"\\s*:\\s*-32603\\b",
      "severity": "fail"
    },
    {
      "pattern": "SSE client send error, closing stream: closed",
      "severity": "ignore"
    }
  ]
}
